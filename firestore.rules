rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email == 'ahhidayat953@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAuthorizedStoreWrite() {
      return incoming().storeId == 'istafa_printing' || isVerifiedAdminEmail();
    }

    function isAuthorizedStoreDelete() {
      return existing().storeId == 'istafa_printing' || isVerifiedAdminEmail();
    }

    // 3. Entity Validation Blueprints
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidAdminSessionState(data) {
      return data.keys().hasAll(['storeId', 'active', 'username', 'sessionToken', 'updatedAt']) &&
        data.keys().hasOnly(['storeId', 'active', 'username', 'sessionToken', 'updatedAt']) &&
        data.storeId == 'istafa_printing' &&
        data.active is bool &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 100 &&
        data.sessionToken is string && data.sessionToken.size() >= 6 && data.sessionToken.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'storeId', 'storeName', 'tagline', 'heroDescription', 'whatsappNumber',
          'logoUrl', 'heroBannerUrl', 'address', 'operatingHours', 'email',
          'instagramUrl', 'facebookUrl', 'tiktokUrl', 'aboutText',
          'initialCashBalance', 'adminUsername', 'adminPasswordHash',
          'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'storeId', 'storeName', 'tagline', 'heroDescription', 'whatsappNumber',
          'logoUrl', 'heroBannerUrl', 'address', 'operatingHours', 'email',
          'instagramUrl', 'facebookUrl', 'tiktokUrl', 'aboutText',
          'initialCashBalance', 'adminUsername', 'adminPasswordHash',
          'updatedAt', 'updatedBy'
        ]) &&
        data.storeId == 'istafa_printing' &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120 &&
        data.tagline is string && data.tagline.size() <= 250 &&
        data.heroDescription is string && data.heroDescription.size() <= 600 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 30 &&
        data.logoUrl is string && data.logoUrl.size() <= 500000 &&
        data.heroBannerUrl is string && data.heroBannerUrl.size() <= 500000 &&
        data.address is string && data.address.size() <= 500 &&
        data.operatingHours is string && data.operatingHours.size() <= 250 &&
        data.email is string && data.email.size() <= 150 &&
        data.instagramUrl is string && data.instagramUrl.size() <= 250 &&
        data.facebookUrl is string && data.facebookUrl.size() <= 250 &&
        data.tiktokUrl is string && data.tiktokUrl.size() <= 250 &&
        data.aboutText is string && data.aboutText.size() <= 1500 &&
        data.initialCashBalance is number &&
        data.adminUsername is string && data.adminUsername.size() >= 1 && data.adminUsername.size() <= 64 &&
        data.adminPasswordHash is string && data.adminPasswordHash.size() >= 1 && data.adminPasswordHash.size() <= 128 &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy.size() <= 100;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'name', 'slug', 'icon', 'description',
          'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'name', 'slug', 'icon', 'description',
          'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120 &&
        data.icon is string && data.icon.size() <= 50 &&
        data.description is string && data.description.size() <= 300 &&
        data.sortOrder is number &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'name', 'categoryId', 'categoryName',
          'price', 'originalPrice', 'description', 'shortDescription',
          'images', 'variants', 'badge', 'available', 'featured',
          'minOrder', 'stock', 'unit', 'orderNotesHint', 'rating', 'soldCount',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'name', 'categoryId', 'categoryName',
          'price', 'originalPrice', 'description', 'shortDescription',
          'images', 'variants', 'badge', 'available', 'featured',
          'minOrder', 'stock', 'unit', 'orderNotesHint', 'rating', 'soldCount',
          'subcategory', 'sizeOptions', 'materialOptions', 'finishingOptions',
          'isNew', 'hidden', 'sortOrder', 'priceLabel',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 100 &&
        data.price is number && data.price >= 0 &&
        data.originalPrice is number && data.originalPrice >= 0 &&
        data.description is string && data.description.size() <= 3000 &&
        data.shortDescription is string && data.shortDescription.size() <= 300 &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 10 &&
        data.images[0] is string && data.images[0].size() <= 500000 &&
        data.variants is list && data.variants.size() <= 20 &&
        (data.variants.size() == 0 || (data.variants[0] is string && data.variants[0].size() <= 120)) &&
        data.badge is string && data.badge.size() <= 60 &&
        data.available is bool &&
        data.featured is bool &&
        data.minOrder is number && data.minOrder >= 1 &&
        data.stock is number && data.stock >= 0 &&
        data.unit is string && data.unit.size() <= 40 &&
        data.orderNotesHint is string && data.orderNotesHint.size() <= 300 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.soldCount is number && data.soldCount >= 0 &&
        (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 120)) &&
        (!('sizeOptions' in data) || (data.sizeOptions is list && data.sizeOptions.size() <= 20 && (data.sizeOptions.size() == 0 || (data.sizeOptions[0] is string && data.sizeOptions[0].size() <= 120)))) &&
        (!('materialOptions' in data) || (data.materialOptions is list && data.materialOptions.size() <= 20 && (data.materialOptions.size() == 0 || (data.materialOptions[0] is string && data.materialOptions[0].size() <= 120)))) &&
        (!('finishingOptions' in data) || (data.finishingOptions is list && data.finishingOptions.size() <= 20 && (data.finishingOptions.size() == 0 || (data.finishingOptions[0] is string && data.finishingOptions[0].size() <= 120)))) &&
        (!('isNew' in data) || data.isNew is bool) &&
        (!('hidden' in data) || data.hidden is bool) &&
        (!('sortOrder' in data) || data.sortOrder is number) &&
        (!('priceLabel' in data) || (data.priceLabel is string && data.priceLabel.size() <= 80)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'title', 'category', 'clientName',
          'description', 'images', 'featured', 'dateLabel',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'title', 'category', 'clientName',
          'description', 'images', 'featured', 'dateLabel',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category is string && data.category.size() <= 100 &&
        data.clientName is string && data.clientName.size() <= 120 &&
        data.description is string && data.description.size() <= 1000 &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 10 &&
        data.images[0] is string && data.images[0].size() <= 500000 &&
        data.featured is bool &&
        data.dateLabel is string && data.dateLabel.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'adminScope', 'orderNumber',
          'customerName', 'customerPhone', 'customerAddress', 'notes',
          'items', 'totalQuantity', 'totalAmount', 'status',
          'paymentStatus', 'paymentMethod', 'financeRecorded', 'financeTxId',
          'dateIso', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'adminScope', 'orderNumber',
          'customerName', 'customerPhone', 'customerAddress', 'notes',
          'items', 'totalQuantity', 'totalAmount', 'status',
          'paymentStatus', 'paymentMethod', 'financeRecorded', 'financeTxId',
          'dateIso', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.adminScope == 'istafa_admin' &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 60 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 150 &&
        data.customerPhone is string && data.customerPhone.size() >= 1 && data.customerPhone.size() <= 40 &&
        data.customerAddress is string && data.customerAddress.size() >= 1 && data.customerAddress.size() <= 600 &&
        data.notes is string && data.notes.size() <= 1000 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
        data.items[0] is map &&
        data.totalQuantity is number && data.totalQuantity >= 1 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.status in ['Baru', 'Diproses', 'Selesai', 'Dibatalkan'] &&
        data.paymentStatus in ['Belum Bayar', 'DP', 'Lunas'] &&
        data.paymentMethod is string && data.paymentMethod.size() <= 50 &&
        data.financeRecorded is bool &&
        data.financeTxId is string && data.financeTxId.size() <= 128 &&
        data.dateIso is string && data.dateIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'adminScope', 'name', 'phone', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'adminScope', 'name', 'phone', 'address',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.adminScope == 'istafa_admin' &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 40 &&
        data.address is string && data.address.size() <= 600 &&
        data.totalOrders is number && data.totalOrders >= 0 &&
        data.totalSpent is number && data.totalSpent >= 0 &&
        data.lastOrderDate is string && data.lastOrderDate.size() <= 40 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFinanceTransaction(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'adminScope', 'transactionNumber', 'type',
          'dateIso', 'sourceOrTarget', 'category', 'amount', 'paymentMethod',
          'description', 'proofImageUrl', 'relatedOrderId',
          'createdBy', 'updatedBy', 'correctionHistory',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'adminScope', 'transactionNumber', 'type',
          'dateIso', 'sourceOrTarget', 'category', 'amount', 'paymentMethod',
          'description', 'proofImageUrl', 'relatedOrderId',
          'createdBy', 'updatedBy', 'correctionHistory',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.adminScope == 'istafa_admin' &&
        data.transactionNumber is string && data.transactionNumber.size() >= 1 && data.transactionNumber.size() <= 60 &&
        data.type in ['income', 'expense', 'cash_in', 'cash_out', 'correction'] &&
        data.dateIso is string && data.dateIso.size() >= 4 && data.dateIso.size() <= 40 &&
        data.sourceOrTarget is string && data.sourceOrTarget.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.amount is number && data.amount >= 0 &&
        data.paymentMethod in ['Cash', 'Transfer', 'QRIS', 'E-wallet', 'Lainnya'] &&
        data.description is string && data.description.size() <= 1000 &&
        data.proofImageUrl is string && data.proofImageUrl.size() <= 500000 &&
        data.relatedOrderId is string && data.relatedOrderId.size() <= 128 &&
        data.createdBy is string && data.createdBy.size() <= 100 &&
        data.updatedBy is string && data.updatedBy.size() <= 100 &&
        data.correctionHistory is list && data.correctionHistory.size() <= 50 &&
        (data.correctionHistory.size() == 0 || (data.correctionHistory[0] is string && data.correctionHistory[0].size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDebtReceivable(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'adminScope', 'recordType', 'partyName', 'phone',
          'dateIso', 'dueDateIso', 'totalAmount', 'paidAmount', 'status',
          'description', 'paymentHistory', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'adminScope', 'recordType', 'partyName', 'phone',
          'dateIso', 'dueDateIso', 'totalAmount', 'paidAmount', 'status',
          'description', 'paymentHistory', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.adminScope == 'istafa_admin' &&
        data.recordType in ['hutang', 'piutang'] &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 160 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.dateIso is string && data.dateIso.size() >= 4 && data.dateIso.size() <= 40 &&
        data.dueDateIso is string && data.dueDateIso.size() <= 40 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.status in ['Belum Lunas', 'Sebagian', 'Lunas'] &&
        data.description is string && data.description.size() <= 1000 &&
        data.paymentHistory is list && data.paymentHistory.size() <= 50 &&
        (data.paymentHistory.size() == 0 || (data.paymentHistory[0] is map)) &&
        data.createdBy is string && data.createdBy.size() <= 100 &&
        data.updatedBy is string && data.updatedBy.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'adminScope', 'action', 'module',
          'details', 'actor', 'dateIso', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'adminScope', 'action', 'module',
          'details', 'actor', 'dateIso', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.storeId == 'istafa_printing' &&
        data.adminScope == 'istafa_admin' &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
        data.module is string && data.module.size() >= 1 && data.module.size() <= 60 &&
        data.details is string && data.details.size() <= 1000 &&
        data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 100 &&
        data.dateIso is string && data.dateIso.size() <= 40 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && request.auth.uid == adminUid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(adminUid) && isVerifiedAdminEmail() &&
        isValidAdminUser(incoming()) &&
        incoming().uid == adminUid;
      allow update, delete: if false;
    }

    match /admin_runtime/{docId} {
      allow get: if isValidId(docId) && docId == 'session_state';
      allow list: if resource.data.storeId == 'istafa_printing';
      allow create: if isValidId(docId) && docId == 'session_state' &&
        isValidAdminSessionState(incoming());
      allow update: if isValidAdminSessionState(incoming()) &&
        isValidId(docId) && docId == 'session_state' &&
        incoming().storeId == existing().storeId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['active', 'username', 'sessionToken', 'updatedAt']);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'store_config';
      allow list: if resource.data.storeId == 'istafa_printing';
      allow create: if isValidId(settingId) && settingId == 'store_config' &&
        isValidStoreSettings(incoming()) &&
        isAuthorizedStoreWrite();
      allow update: if isValidStoreSettings(incoming()) &&
        isValidId(settingId) && settingId == 'store_config' &&
        incoming().storeId == existing().storeId &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'tagline', 'heroDescription', 'whatsappNumber',
          'logoUrl', 'heroBannerUrl', 'address', 'operatingHours', 'email',
          'instagramUrl', 'facebookUrl', 'tiktokUrl', 'aboutText',
          'initialCashBalance', 'adminUsername', 'adminPasswordHash',
          'updatedAt', 'updatedBy'
        ]);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if resource.data.storeId == 'istafa_printing';
      allow create: if isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().id == categoryId &&
        isAuthorizedStoreWrite();
      allow update: if isValidCategory(incoming()) &&
        isValidId(categoryId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'icon', 'description', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(categoryId) &&
        isAuthorizedStoreDelete();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if resource.data.storeId == 'istafa_printing';
      allow create: if isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().id == productId &&
        isAuthorizedStoreWrite();
      allow update: if isValidProduct(incoming()) &&
        isValidId(productId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'categoryId', 'categoryName', 'subcategory', 'price', 'originalPrice',
          'priceLabel', 'description', 'shortDescription', 'images', 'variants',
          'sizeOptions', 'materialOptions', 'finishingOptions', 'badge',
          'available', 'featured', 'isNew', 'hidden', 'sortOrder', 'minOrder',
          'stock', 'unit', 'orderNotesHint', 'rating', 'soldCount', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(productId) &&
        isAuthorizedStoreDelete();
    }

    match /gallery/{galleryId} {
      allow get: if isValidId(galleryId);
      allow list: if resource.data.storeId == 'istafa_printing';
      allow create: if isValidId(galleryId) &&
        isValidGalleryItem(incoming()) &&
        incoming().id == galleryId &&
        isAuthorizedStoreWrite();
      allow update: if isValidGalleryItem(incoming()) &&
        isValidId(galleryId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'clientName', 'description',
          'images', 'featured', 'dateLabel', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(galleryId) &&
        isAuthorizedStoreDelete();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if resource.data.storeId == 'istafa_printing' && resource.data.adminScope == 'istafa_admin';
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().id == orderId;
      allow update: if isValidOrder(incoming()) &&
        isValidId(orderId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        incoming().adminScope == existing().adminScope &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'customerName', 'customerPhone', 'customerAddress', 'notes',
          'items', 'totalQuantity', 'totalAmount', 'status',
          'paymentStatus', 'paymentMethod', 'financeRecorded', 'financeTxId',
          'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(orderId) &&
        isAuthorizedStoreDelete();
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if resource.data.storeId == 'istafa_printing' && resource.data.adminScope == 'istafa_admin';
      allow create: if isValidId(customerId) &&
        isValidCustomer(incoming()) &&
        incoming().id == customerId;
      allow update: if isValidCustomer(incoming()) &&
        isValidId(customerId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        incoming().adminScope == existing().adminScope &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'phone', 'address', 'totalOrders', 'totalSpent', 'lastOrderDate', 'notes', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(customerId) &&
        isAuthorizedStoreDelete();
    }

    match /finance_transactions/{txId} {
      allow get: if isValidId(txId);
      allow list: if resource.data.storeId == 'istafa_printing' && resource.data.adminScope == 'istafa_admin';
      allow create: if isValidId(txId) &&
        isValidFinanceTransaction(incoming()) &&
        incoming().id == txId &&
        isAuthorizedStoreWrite();
      allow update: if isValidFinanceTransaction(incoming()) &&
        isValidId(txId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        incoming().adminScope == existing().adminScope &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'dateIso', 'sourceOrTarget', 'category', 'amount',
          'paymentMethod', 'description', 'proofImageUrl',
          'updatedBy', 'correctionHistory', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(txId) &&
        isAuthorizedStoreDelete();
    }

    match /debts_receivables/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if resource.data.storeId == 'istafa_printing' && resource.data.adminScope == 'istafa_admin';
      allow create: if isValidId(recordId) &&
        isValidDebtReceivable(incoming()) &&
        incoming().id == recordId &&
        isAuthorizedStoreWrite();
      allow update: if isValidDebtReceivable(incoming()) &&
        isValidId(recordId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        incoming().adminScope == existing().adminScope &&
        isAuthorizedStoreWrite() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'recordType', 'partyName', 'phone', 'dateIso', 'dueDateIso',
          'totalAmount', 'paidAmount', 'status', 'description',
          'paymentHistory', 'updatedBy', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(recordId) &&
        isAuthorizedStoreDelete();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if resource.data.storeId == 'istafa_printing' && resource.data.adminScope == 'istafa_admin';
      allow create: if isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        isAuthorizedStoreWrite();
      allow update, delete: if false;
    }
  }
}
